---
/**
 * The playlist, with a player wrapped around Spotify's embed.
 *
 * Renders the first track and the head of the queue server-side, so the panel
 * is a real thing in the HTML with a real cover, real titles and real links
 * before any script runs. Nothing third-party loads until someone presses play:
 * not the embed, not Spotify's iframe API, not the track list. A visitor who
 * never presses it makes exactly the requests they made before this existed.
 */
import playlist from "../data/playlist.json";

interface Props {
  /** How many upcoming tracks to show. The rest still play. */
  listed?: number;
}

const { listed = 6 } = Astro.props;

/*
  The panel opens on a different song for every visitor, and the whole cost of
  that is the blocks below.

  Shuffling per visit needs track data on the client, and the full list is
  35.5KB that this site deliberately does not spend on people who never press
  play. So the build inlines a few short runs of tracks instead, and the
  visitor picks a start inside one of them.

  Runs, not single tracks, because playback continues in order from wherever it
  starts: the queue under the deck has to show the tracks that really follow.
  That is also why each run gives BLOCK - listed starts rather than BLOCK. The
  last `listed` tracks of a run cannot open, because there would be nothing
  truthful to put in the queue beneath them.

  BLOCKS runs spread across the playlist rather than one long run, so the
  opening song can come from anywhere in it and not just one neighbourhood.
  Each run is placed at random inside its own slot, so the neighbourhoods move
  on every deploy rather than being the same six forever.

  These two numbers are the only knob. Widening a run is the cheap way to buy
  opening songs and narrowing it is expensive, which is the opposite of the
  obvious guess: every run spends `listed` tracks on a tail that cannot open,
  so a run of 14 costs 1.75 records per opening song and a run of 20 costs
  1.43. Adding runs, by contrast, costs full price. 6x20 is 84 opening songs
  for the same bytes 8x14 spent on 64. Past about 20 the curve flattens and
  you are just concentrating the starts.

  Nothing here has to cover next or previous. Those are disabled until the
  first press of play, and that press fetches the whole 224 track list, which
  every later navigation runs off. This data exists only to paint the panel
  before any of that happens.
*/
const BLOCKS = 6;
const BLOCK = 20;

const stride = Math.floor(playlist.tracks.length / BLOCKS);
const compact = (track: (typeof playlist.tracks)[number]) => ({
  i: track.id,
  a: track.art.replace("https://i.scdn.co/image/", ""),
  n: track.name,
  r: track.artists.map((artist) => [artist.name, artist.id]),
  d: track.durationMs,
});

/* `s` is where the run sits in the real playlist, which is what makes an
   absolute index recoverable from a pick inside it. */
const blocks =
  stride >= BLOCK
    ? Array.from({ length: BLOCKS }, (_, slot) => {
        const at =
          slot * stride + Math.floor(Math.random() * (stride - BLOCK + 1));
        return { s: at, t: playlist.tracks.slice(at, at + BLOCK).map(compact) };
      })
    : [{ s: 0, t: playlist.tracks.slice(0, BLOCK).map(compact) }];

/*
  What renders server-side, and therefore what a visitor with JavaScript off
  sees. Picked the same way the client picks, so that fallback is a real
  opening song from a real run rather than always track one, and it moves every
  deploy too.
*/
const openBlock = blocks[Math.floor(Math.random() * blocks.length)];
const openOffset = Math.floor(Math.random() * (openBlock.t.length - listed));
const openAt = openBlock.s + openOffset;

const first = playlist.tracks[openAt];
const upNext = playlist.tracks.slice(openAt + 1, openAt + 1 + listed);

/*
  mm:ss. Durations here run from about ninety seconds to nine minutes, so the
  hour case cannot arise and is not handled; if a track ever needs it, this is
  the thing that will look wrong.
*/
const clock = (ms: number) => {
  const total = Math.round(ms / 1000);
  return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
};

const artistUrl = (id: string) => `https://open.spotify.com/artist/${id}`;

const runtime = playlist.tracks.reduce((sum, t) => sum + t.durationMs, 0);
const hours = Math.floor(runtime / 3_600_000);
const minutes = Math.round((runtime % 3_600_000) / 60_000);
---

{/*
  The runs, as data rather than as generated code, and first in the component
  on purpose: it has to be parsed before the cover below it, because the script
  that rewrites the cover cannot run until this exists.

  `<` is escaped because a track name containing "</script>" would otherwise
  end this element early.
*/}
<script
  type="application/json"
  id="player-blocks"
  is:inline
  set:html={JSON.stringify({ l: listed, b: blocks }).replace(/</g, "\\u003c")}
/>

<section aria-labelledby="playlist-heading">
  <h2 class="section-title" id="playlist-heading">What's on my playlist</h2>

  <div class="panel player">

  <div class="player__deck">
    {/*
      Spotify's own artwork, unaltered and hotlinked from their CDN, which is
      what their terms ask for. It is also the only third-party request this
      section makes before you press anything.
    */}
    <img
      class="player__art"
      id="player-art"
      src={first.art}
      alt=""
      width="300"
      height="300"
      loading="lazy"
      decoding="async"
    />

    <div class="player__meta">
      <p class="player__track" id="player-track">{first.name}</p>
      <p class="player__artist" id="player-artist">
        {
          first.artists.map((artist, i) => (
            <>
              {i > 0 && ", "}
              <a href={artistUrl(artist.id)} target="_blank" rel="noopener noreferrer">
                {artist.name}
              </a>
            </>
          ))
        }
      </p>

      {/*
        A real range input, so it can be dragged with a mouse, nudged with arrow
        keys and read by a screen reader as the slider it is. A div with a
        coloured child would have needed all three rebuilt by hand.
      */}
      <div class="player__scrub">
        <input
          class="player__seek"
          id="player-seek"
          type="range"
          min="0"
          max={Math.round(first.durationMs / 1000)}
          value="0"
          step="1"
          disabled
          aria-label="Seek within the current track"
        />
        <p class="player__time">
          <span id="player-elapsed">0:00</span> / <span id="player-duration">{clock(first.durationMs)}</span>
        </p>
      </div>

      <div class="player__controls">
        <button class="player__button" id="player-prev" type="button" disabled>
          <span aria-hidden="true">|&lt;&lt;</span>
          <span class="visually-hidden">Previous track</span>
        </button>
        <button class="player__button player__button--play" id="player-play" type="button">
          <span id="player-play-glyph" aria-hidden="true">&gt;</span>
          <span class="visually-hidden" id="player-play-label">Play</span>
        </button>
        <button class="player__button" id="player-next" type="button" disabled>
          <span aria-hidden="true">&gt;&gt;|</span>
          <span class="visually-hidden">Next track</span>
        </button>
        <p class="player__position"><span id="player-index">{openAt + 1}</span> / {playlist.trackCount}</p>
      </div>

      {/*
        Leads with the case that works, because it is the common one: signed in
        to Premium, tracks play in full. A second sentence used to follow,
        "Safari and Brave block that check either way", which is true: those
        browsers block the third-party cookie the embed reads to know who you
        are, so for their users signing in changes nothing. He read it and cut
        it, reasoning that a recruiter does not need the cookie mechanics, and
        accepted the cost knowingly: on those browsers the sign in suggestion
        quietly does nothing. Do not put the sentence back without asking.
      */}
      <p class="player__notice">
        These play in full if you are signed in to Spotify Premium in this
        browser, and thirty seconds each if not.{" "}
        <a href="https://accounts.spotify.com/login" target="_blank" rel="noopener noreferrer">
          Sign in
        </a>{" "}
        then reload, or{" "}
        <a id="player-open" href={first.url} target="_blank" rel="noopener noreferrer">
          open this track on Spotify
        </a>.
      </p>
    </div>
  </div>

  {/*
    Picks the opening song, and has to beat the browser to the cover.

    is:inline with no type="module", so it executes during parsing rather than
    after it, and it sits directly under the deck rather than at the end of the
    component. Both of those matter. The cover carries loading="lazy" and sits
    696px to 750px down the home page against desktop folds of 800px and up, so
    the browser starts fetching it on its own; a deferred script would repaint
    it in full view about 100ms after load.

    What actually happens, measured rather than assumed: the browser does begin
    the server-rendered cover, and this rewrite aborts it. Resource timing
    records that first entry with a 0ms duration and 0 bytes transferred, while
    the shuffled cover is the only one that moves real bytes. So it is not that
    the wrong cover is never requested, it is that it is cancelled before any
    of it arrives, which is why nothing is ever painted twice.

    Do not "fix" the duplicate entry in the timeline by deferring this script.
    That trades a cancelled 0 byte request for a completed one plus a visible
    swap.

    The queue is handled by the second half, below the rows it rewrites, since
    nothing down there races an image.
  */}
  <script is:inline>
    (function () {
      var source = document.getElementById("player-blocks");
      var deck = document.getElementById("player-track");
      if (!source || !deck) return;

      /*
        Stand down if something is already playing.

        Under the client router this script runs again every time the visitor
        navigates back to the home page, and a fresh random pick would repaint
        the deck to a song that is not the one coming out of the speakers. The
        controller repaints the panel itself in that case, from what is
        actually playing. See PlayerDock.
      */
      if (window.__playerActive) return;

      var data = JSON.parse(source.textContent);
      var blocks = data.b || [];
      if (!blocks.length) return;

      /*
        ONCE PER VISIT, NOT ONCE PER PAGE VIEW.

        The client router re-runs this every time the home page is entered, so
        picking here unconditionally would reshuffle on every trip back from
        /experience. Somebody who reads a card and comes back would find a
        different song sitting in the deck, which reads as the page losing its
        place rather than as a feature.

        So the pick is made once and remembered on `window`, and every later
        run re-applies it. `window` is the right scope precisely because it is
        the thing the router does not replace: it lasts exactly as long as the
        visit does, and a real reload is a new visit and deserves a new song.

        Stored as a run index and an offset rather than the track itself, since
        the runs are generated at build time and are identical on every page of
        a given build.
      */
      var pick = window.__playerPick;
      if (!pick) {
        // A run first, then a start inside it. The tail of a run cannot open,
        // because the queue below the deck would have nothing true to show.
        var at = Math.floor(Math.random() * blocks.length);
        if (blocks[at].t.length <= data.l) return;
        pick = { b: at, o: Math.floor(Math.random() * (blocks[at].t.length - data.l)) };
        window.__playerPick = pick;
      }

      var block = blocks[pick.b];
      var offset = pick.o;
      if (!block || block.t.length <= offset + data.l) return;

      var track = block.t[offset];
      var clock = function (ms) {
        var t = Math.round(ms / 1000);
        return Math.floor(t / 60) + ":" + String(t % 60).padStart(2, "0");
      };

      /* Astro scopes this component's CSS with a generated attribute. Any
         element built here needs it or every scoped rule skips the element. */
      var cid = null;
      var sample = document.querySelector("#player-artist a");
      if (sample) {
        for (var i = 0; i < sample.attributes.length; i++) {
          var attr = sample.attributes[i].name;
          if (attr.indexOf("data-astro-cid-") === 0) cid = attr;
        }
      }

      /* Names go in as text, never as markup: they arrive from an API. */
      var artistsInto = function (host, pairs) {
        host.replaceChildren();
        pairs.forEach(function (pair, n) {
          if (n > 0) host.append(", ");
          var link = document.createElement("a");
          if (cid) link.setAttribute(cid, "");
          link.href = "https://open.spotify.com/artist/" + pair[1];
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.textContent = pair[0];
          host.append(link);
        });
      };

      /*
        Kept as a function because the deck has to be repainted every time the
        home page is entered, not only the first time.

        Astro does not re-execute an inline script after a client-side swap, so
        without this the panel would come back showing whatever the build
        rendered into it rather than the song this visit picked. Measured
        before it was fixed: first view "Ghost Town", back from /experience
        "LEMON LIME", which is the build-time default.

        Everything is looked up inside, because on a re-entry every one of
        these elements is a node that did not exist a moment ago.
      */
      var applyDeck = function () {
        var name = document.getElementById("player-track");
        if (!name) return;
        document.getElementById("player-art").src =
          "https://i.scdn.co/image/" + track.a;
        name.textContent = track.n;
        artistsInto(document.getElementById("player-artist"), track.r);
        document.getElementById("player-duration").textContent = clock(track.d);
        document.getElementById("player-open").href =
          "https://open.spotify.com/track/" + track.i;
        document.getElementById("player-index").textContent =
          String(block.s + offset + 1);
        var seek = document.getElementById("player-seek");
        seek.max = String(Math.round(track.d / 1000));
        seek.value = "0";
      };

      applyDeck();

      /* Handed to the second half, which cannot re-run the pick without
         choosing a different song than the one now on screen. */
      window.__playerOpening = {
        block: block,
        offset: offset,
        into: artistsInto,
        clock: clock,
        deck: applyDeck,
      };
    })();
  </script>

  <p class="player__queue-label">Up next</p>
  <ul class="player__list" id="player-queue">
    {
      upNext.map((track, offset) => (
        <li class="player__row">
          <button class="player__row-play" type="button" data-jump={offset + 1}>
            {track.name}
          </button>
          <span class="player__row-artist">
            {track.artists.map((artist, i) => (
              <>
                {i > 0 && ", "}
                <a href={artistUrl(artist.id)} target="_blank" rel="noopener noreferrer">
                  {artist.name}
                </a>
              </>
            ))}
          </span>
          <span class="player__row-time">{clock(track.durationMs)}</span>
        </li>
      ))
    }
  </ul>

    {/*
      The other half of the shuffle, below the rows it rewrites.

      It rewrites the rows the server already rendered instead of rebuilding
      them. Rebuilding would mean re-stamping Astro's scoped-style attribute
      onto every new node, which is the bug documented in PlayerDock's
      controller; updating text in place cannot hit it.

      The pick is handed over on `window`, not by writing an attribute onto the
      embed. The embed lives in the dock now, which the layout renders after
      the page content, so it does not exist yet while this is running:
      getElementById would return null here and the start index would silently
      fall back to zero. `window` has no such ordering problem.
    */}
    <script is:inline>
      (function () {
        var open = window.__playerOpening;
        if (!open) return;
        delete window.__playerOpening;

        window.__playerStart = open.block.s + open.offset;

        var applyQueue = function () {
          var rows = document.querySelectorAll("#player-queue .player__row");
          for (var row = 0; row < rows.length; row++) {
            var next = open.block.t[open.offset + 1 + row];
            if (!next) break;
            rows[row].querySelector(".player__row-play").textContent = next.n;
            open.into(rows[row].querySelector(".player__row-artist"), next.r);
            rows[row].querySelector(".player__row-time").textContent = open.clock(next.d);
          }
        };

        applyQueue();

        /*
          Re-apply on every later entry to the home page.

          An inline script is not re-executed after a client-side swap, so this
          listener is the only thing that runs when somebody comes back from
          /experience. Without it the panel returns showing the build-time
          default rather than the song this visit picked.

          Registered once: this whole script only runs on the first entry, for
          the same reason. If something is playing by then the controller owns
          the panel and repaints it from what is actually coming out of the
          speakers, so this stands aside.
        */
        document.addEventListener("astro:page-load", function () {
          if (window.__playerActive) return;
          open.deck();
          applyQueue();
        });
      })();
    </script>

    <p class="player__foot">{playlist.trackCount} tracks, {hours}h {minutes}m</p>
  </div>
</section>


<style>
  /*
    A player, laid out like one: the cover on the left, everything you read or
    press to its right. It collapses to one column when the row gets narrower
    than about 26rem, which is the width below which the cover and a legible
    track title stop fitting side by side.
  */
  .player__deck {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
    align-items: flex-start;
  }

  .player__art {
    flex: 0 0 auto;
    width: 128px;
    height: 128px;
    /* The artwork is square and must not be cropped or distorted, so the box is
       square too and the image fills it exactly. Spotify's guidelines are
       explicit about not altering artwork, which includes reframing it. */
    object-fit: cover;
    border: 1px solid var(--amber-ghost);
    background: var(--bg-inset);
  }

  .player__meta {
    flex: 1 1 16rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  /*
    Titles here run to 98 characters, so both lines clip rather than wrap. A
    two line title would push the scrubber down and make the panel's height
    depend on which track is playing, which looks like a bug when it happens
    mid-song.
  */
  .player__track,
  .player__artist {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player__track {
    font-size: var(--text-lg);
    color: var(--amber-max);
  }

  .player__artist {
    font-size: var(--text-sm);
    color: var(--amber-dim);
  }

  .player__scrub {
    margin-top: var(--s2);
  }

  .player__time {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
    margin-top: var(--s1);
  }

  /*
    The scrubber is something you can act on, so it is blue, and the part behind
    it is inert, so it is not. Range inputs need the track and thumb styled per
    engine or they arrive as the operating system's own widget, which is the one
    control on this site that would look borrowed.
  */
  .player__seek {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 14px;
    background: none;
    cursor: pointer;
    /* 0 to 1, written by the script on every position change. Unitless, so the
       arithmetic below can be done against a 100% only the browser knows. */
    --progress: 0;
  }

  /*
    The trail behind the thumb: how far into the track you are.

    Amber, not blue, and that is the palette rule rather than a preference. The
    trail is something you read; the thumb is the only part of this you can
    grab, so it stays the only blue thing in the control.

    WebKit has no lower-fill pseudo-element, so the track paints it as a
    two-stop gradient. The stop is not a plain percentage, and that is the
    whole trick: the thumb is 10px wide and travels between the track's inset
    edges, so its centre runs from 5px to (width - 5px), not from 0 to width. A
    plain 50% would leave the trail up to 5px away from the dot it is supposed
    to be attached to, worst at the two ends. Correcting inside calc() means
    100% is resolved at paint time, so this survives a resize with no
    JavaScript listening for one.
  */
  .player__seek::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(
        to right,
        var(--amber-dim) 0 calc(var(--progress) * (100% - 10px) + 5px),
        var(--amber-ghost) calc(var(--progress) * (100% - 10px) + 5px) 100%
      )
      no-repeat;
  }

  /* Firefox has a real lower-fill element, so it needs none of the arithmetic
     above: the engine already knows where the thumb is. */
  .player__seek::-moz-range-track {
    height: 2px;
    background: var(--amber-ghost);
  }

  .player__seek::-moz-range-progress {
    height: 2px;
    background: var(--amber-dim);
  }

  .player__seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 10px;
    height: 10px;
    margin-top: -4px;
    background: var(--blue);
    border: 0;
  }

  .player__seek::-moz-range-thumb {
    width: 10px;
    height: 10px;
    background: var(--blue);
    border: 0;
    border-radius: 0;
  }

  /* Before anyone presses play there is no position to report, so the trail is
     not drawn at all rather than drawn at zero. */
  .player__seek:disabled {
    cursor: default;
  }

  .player__seek:disabled::-webkit-slider-runnable-track {
    background: var(--amber-ghost);
  }

  .player__seek:disabled::-moz-range-progress {
    background: none;
  }

  .player__seek:disabled::-webkit-slider-thumb {
    background: var(--amber-faint);
  }

  .player__seek:disabled::-moz-range-thumb {
    background: var(--amber-faint);
  }

  .player__controls {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-top: var(--s3);
  }

  .player__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    padding: var(--s2) var(--s3);
    border: 1px solid var(--blue-dim);
    background: var(--bg-inset);
    color: var(--blue);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 90ms linear, border-color 90ms linear, color 90ms linear;
  }

  .player__button:hover:not(:disabled) {
    background: var(--blue-ghost);
    border-color: var(--blue);
    color: var(--blue-hi);
  }

  .player__button:active:not(:disabled) {
    translate: 0 1px;
  }

  .player__button:disabled {
    border-color: var(--amber-faint);
    color: var(--amber-faint);
    cursor: not-allowed;
  }

  .player__position {
    margin-left: auto;
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }

  /*
    Spotify's player, kept visible because their terms require it and framed as
    what it is: the thing doing the playing, under a label, rather than a second
    player competing with the deck above. It cannot be hidden or restyled, and
    the Web Playback SDK, which is the only way to have a custom player without
    it, needs Extended Quota Mode. That tier asks for a registered business and
    250,000 monthly active users, so it is not coming.
  */
  .player__source {
    margin-top: var(--s5);
    padding-top: var(--s4);
    border-top: 1px solid var(--amber-ghost);
  }

  .player__source-label {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
    margin-bottom: var(--s2);
  }

  .player__notice {
    margin-top: var(--s3);
    font-size: var(--text-sm);
    color: var(--amber-dim);
  }

  .player__list {
    list-style: none;
    padding: 0;
    margin-top: var(--s2);
    border-top: 1px solid var(--amber-ghost);
  }

  .player__row {
    display: flex;
    gap: var(--s3);
    align-items: baseline;
    padding: var(--s2) 0;
    border-bottom: 1px solid var(--amber-ghost);
    font-size: var(--text-sm);
    color: var(--amber-dim);
  }

  /*
    The title is a button that jumps the queue to that track, so it is blue,
    like everything else on this site you can act on. A whole row of blue would
    have been too loud, which is why the duration stays inert amber and only the
    two things that do something take the colour.
  */
  .player__row-play {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--blue);
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player__row-play:hover {
    color: var(--blue-hi);
    text-decoration: underline;
  }

  .player__queue-label {
    margin-top: var(--s5);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
