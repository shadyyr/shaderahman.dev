---
/**
 * The playlist, with a player wrapped around Spotify's embed.
 *
 * Renders the first track and the head of the queue server-side, so the panel
 * is a real thing in the HTML with a real cover, real titles and real links
 * before any script runs. Nothing third-party loads until someone presses play:
 * not the embed, not Spotify's iframe API, not the track list. A visitor who
 * never presses it makes exactly the requests they made before this existed.
 */
import playlist from "../data/playlist.json";

interface Props {
  /** How many upcoming tracks to show. The rest still play. */
  listed?: number;
}

const { listed = 6 } = Astro.props;

/*
  The panel opens on a different song for every visitor, and the whole cost of
  that is the blocks below.

  Shuffling per visit needs track data on the client, and the full list is
  35.5KB that this site deliberately does not spend on people who never press
  play. So the build inlines a few short runs of tracks instead, and the
  visitor picks a start inside one of them.

  Runs, not single tracks, because playback continues in order from wherever it
  starts: the queue under the deck has to show the tracks that really follow.
  That is also why each run gives BLOCK - listed starts rather than BLOCK. The
  last `listed` tracks of a run cannot open, because there would be nothing
  truthful to put in the queue beneath them.

  BLOCKS runs spread across the playlist rather than one long run, so the
  opening song can come from anywhere in it and not just one neighbourhood.
  Each run is placed at random inside its own slot, so the neighbourhoods move
  on every deploy rather than being the same six forever.

  These two numbers are the only knob. Widening a run is the cheap way to buy
  opening songs and narrowing it is expensive, which is the opposite of the
  obvious guess: every run spends `listed` tracks on a tail that cannot open,
  so a run of 14 costs 1.75 records per opening song and a run of 20 costs
  1.43. Adding runs, by contrast, costs full price. 6x20 is 84 opening songs
  for the same bytes 8x14 spent on 64. Past about 20 the curve flattens and
  you are just concentrating the starts.

  Nothing here has to cover next or previous. Those are disabled until the
  first press of play, and that press fetches the whole 224 track list, which
  every later navigation runs off. This data exists only to paint the panel
  before any of that happens.
*/
const BLOCKS = 6;
const BLOCK = 20;

const stride = Math.floor(playlist.tracks.length / BLOCKS);
const compact = (track: (typeof playlist.tracks)[number]) => ({
  i: track.id,
  a: track.art.replace("https://i.scdn.co/image/", ""),
  n: track.name,
  r: track.artists.map((artist) => [artist.name, artist.id]),
  d: track.durationMs,
});

/* `s` is where the run sits in the real playlist, which is what makes an
   absolute index recoverable from a pick inside it. */
const blocks =
  stride >= BLOCK
    ? Array.from({ length: BLOCKS }, (_, slot) => {
        const at =
          slot * stride + Math.floor(Math.random() * (stride - BLOCK + 1));
        return { s: at, t: playlist.tracks.slice(at, at + BLOCK).map(compact) };
      })
    : [{ s: 0, t: playlist.tracks.slice(0, BLOCK).map(compact) }];

/*
  What renders server-side, and therefore what a visitor with JavaScript off
  sees. Picked the same way the client picks, so that fallback is a real
  opening song from a real run rather than always track one, and it moves every
  deploy too.
*/
const openBlock = blocks[Math.floor(Math.random() * blocks.length)];
const openOffset = Math.floor(Math.random() * (openBlock.t.length - listed));
const openAt = openBlock.s + openOffset;

const first = playlist.tracks[openAt];
const upNext = playlist.tracks.slice(openAt + 1, openAt + 1 + listed);

/*
  mm:ss. Durations here run from about ninety seconds to nine minutes, so the
  hour case cannot arise and is not handled; if a track ever needs it, this is
  the thing that will look wrong.
*/
const clock = (ms: number) => {
  const total = Math.round(ms / 1000);
  return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
};

const artistUrl = (id: string) => `https://open.spotify.com/artist/${id}`;

const runtime = playlist.tracks.reduce((sum, t) => sum + t.durationMs, 0);
const hours = Math.floor(runtime / 3_600_000);
const minutes = Math.round((runtime % 3_600_000) / 60_000);
---

{/*
  The runs, as data rather than as generated code, and first in the component
  on purpose: it has to be parsed before the cover below it, because the script
  that rewrites the cover cannot run until this exists.

  `<` is escaped because a track name containing "</script>" would otherwise
  end this element early.
*/}
<script
  type="application/json"
  id="player-blocks"
  is:inline
  set:html={JSON.stringify({ l: listed, b: blocks }).replace(/</g, "\\u003c")}
/>

<section aria-labelledby="playlist-heading">
  <h2 class="section-title" id="playlist-heading">What's on my playlist</h2>

  <div class="panel player">

  <div class="player__deck">
    {/*
      Spotify's own artwork, unaltered and hotlinked from their CDN, which is
      what their terms ask for. It is also the only third-party request this
      section makes before you press anything.
    */}
    <img
      class="player__art"
      id="player-art"
      src={first.art}
      alt=""
      width="300"
      height="300"
      loading="lazy"
      decoding="async"
    />

    <div class="player__meta">
      <p class="player__track" id="player-track">{first.name}</p>
      <p class="player__artist" id="player-artist">
        {
          first.artists.map((artist, i) => (
            <>
              {i > 0 && ", "}
              <a href={artistUrl(artist.id)} target="_blank" rel="noopener noreferrer">
                {artist.name}
              </a>
            </>
          ))
        }
      </p>

      {/*
        A real range input, so it can be dragged with a mouse, nudged with arrow
        keys and read by a screen reader as the slider it is. A div with a
        coloured child would have needed all three rebuilt by hand.
      */}
      <div class="player__scrub">
        <input
          class="player__seek"
          id="player-seek"
          type="range"
          min="0"
          max={Math.round(first.durationMs / 1000)}
          value="0"
          step="1"
          disabled
          aria-label="Seek within the current track"
        />
        <p class="player__time">
          <span id="player-elapsed">0:00</span> / <span id="player-duration">{clock(first.durationMs)}</span>
        </p>
      </div>

      <div class="player__controls">
        <button class="player__button" id="player-prev" type="button" disabled>
          <span aria-hidden="true">|&lt;&lt;</span>
          <span class="visually-hidden">Previous track</span>
        </button>
        <button class="player__button player__button--play" id="player-play" type="button">
          <span id="player-play-glyph" aria-hidden="true">&gt;</span>
          <span class="visually-hidden" id="player-play-label">Play</span>
        </button>
        <button class="player__button" id="player-next" type="button" disabled>
          <span aria-hidden="true">&gt;&gt;|</span>
          <span class="visually-hidden">Next track</span>
        </button>
        <p class="player__position"><span id="player-index">{openAt + 1}</span> / {playlist.trackCount}</p>
      </div>

      {/*
        Leads with the case that works, because it is the common one: signed in
        to Premium, tracks play in full. A second sentence used to follow,
        "Safari and Brave block that check either way", which is true: those
        browsers block the third-party cookie the embed reads to know who you
        are, so for their users signing in changes nothing. He read it and cut
        it, reasoning that a recruiter does not need the cookie mechanics, and
        accepted the cost knowingly: on those browsers the sign in suggestion
        quietly does nothing. Do not put the sentence back without asking.
      */}
      <p class="player__notice">
        These play in full if you are signed in to Spotify Premium in this
        browser, and thirty seconds each if not.{" "}
        <a href="https://accounts.spotify.com/login" target="_blank" rel="noopener noreferrer">
          Sign in
        </a>{" "}
        then reload, or{" "}
        <a id="player-open" href={first.url} target="_blank" rel="noopener noreferrer">
          open this track on Spotify
        </a>.
      </p>
    </div>
  </div>

  {/*
    Picks the opening song, and has to beat the browser to the cover.

    is:inline with no type="module", so it executes during parsing rather than
    after it, and it sits directly under the deck rather than at the end of the
    component. Both of those matter. The cover carries loading="lazy" and sits
    696px to 750px down the home page against desktop folds of 800px and up, so
    the browser starts fetching it on its own; a deferred script would repaint
    it in full view about 100ms after load.

    What actually happens, measured rather than assumed: the browser does begin
    the server-rendered cover, and this rewrite aborts it. Resource timing
    records that first entry with a 0ms duration and 0 bytes transferred, while
    the shuffled cover is the only one that moves real bytes. So it is not that
    the wrong cover is never requested, it is that it is cancelled before any
    of it arrives, which is why nothing is ever painted twice.

    Do not "fix" the duplicate entry in the timeline by deferring this script.
    That trades a cancelled 0 byte request for a completed one plus a visible
    swap.

    The queue is handled by the second half, below the rows it rewrites, since
    nothing down there races an image.
  */}
  <script is:inline>
    (function () {
      var source = document.getElementById("player-blocks");
      var deck = document.getElementById("player-track");
      if (!source || !deck) return;

      var data = JSON.parse(source.textContent);
      var blocks = data.b || [];
      if (!blocks.length) return;

      // A run first, then a start inside it. The tail of a run cannot open,
      // because the queue below the deck would have nothing true to show.
      var block = blocks[Math.floor(Math.random() * blocks.length)];
      if (block.t.length <= data.l) return;
      var offset = Math.floor(Math.random() * (block.t.length - data.l));

      var track = block.t[offset];
      var clock = function (ms) {
        var t = Math.round(ms / 1000);
        return Math.floor(t / 60) + ":" + String(t % 60).padStart(2, "0");
      };

      /* Astro scopes this component's CSS with a generated attribute. Any
         element built here needs it or every scoped rule skips the element. */
      var cid = null;
      var sample = document.querySelector("#player-artist a");
      if (sample) {
        for (var i = 0; i < sample.attributes.length; i++) {
          var attr = sample.attributes[i].name;
          if (attr.indexOf("data-astro-cid-") === 0) cid = attr;
        }
      }

      /* Names go in as text, never as markup: they arrive from an API. */
      var artistsInto = function (host, pairs) {
        host.replaceChildren();
        pairs.forEach(function (pair, n) {
          if (n > 0) host.append(", ");
          var link = document.createElement("a");
          if (cid) link.setAttribute(cid, "");
          link.href = "https://open.spotify.com/artist/" + pair[1];
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.textContent = pair[0];
          host.append(link);
        });
      };

      document.getElementById("player-art").src =
        "https://i.scdn.co/image/" + track.a;
      deck.textContent = track.n;
      artistsInto(document.getElementById("player-artist"), track.r);
      document.getElementById("player-duration").textContent = clock(track.d);
      document.getElementById("player-open").href =
        "https://open.spotify.com/track/" + track.i;
      document.getElementById("player-index").textContent =
        String(block.s + offset + 1);

      var seek = document.getElementById("player-seek");
      seek.max = String(Math.round(track.d / 1000));
      seek.value = "0";

      /* Handed to the second half, which cannot re-run the pick without
         choosing a different song than the one now on screen. */
      window.__playerOpening = { block: block, offset: offset, into: artistsInto, clock: clock };
    })();
  </script>

  {/*
    Spotify's player. It has to stay visible: their terms require the embed and
    its branding be shown and unaltered, so this is not a widget being hidden
    behind a nicer one. It is the thing actually playing, and the deck above is
    a set of controls for it.

    It is also the one thing here that does not take the site's colours. The
    embed tints itself with the artwork's dominant colour, so it changes every
    track and is often a block of blue in a palette where blue means "you can
    click this". createController silently ignores unknown options, so passing
    theme: 0 does nothing; it was tried. The only way to be rid of it is the Web
    Playback SDK, which needs Extended Quota Mode, which asks for a registered
    business and 250,000 monthly active users.
  */}
  <div class="player__source" id="player-source" hidden>
    <p class="player__source-label">playing via</p>
    {/* Where in the full playlist the panel is currently sitting. Written by
        the shuffle below, read by the controller, so the two cannot disagree
        about which track "play" means. */}
    <div class="player__embed" id="player-embed" data-start={openAt}></div>
  </div>

  <p class="player__queue-label">Up next</p>
  <ul class="player__list" id="player-queue">
    {
      upNext.map((track, offset) => (
        <li class="player__row">
          <button class="player__row-play" type="button" data-jump={offset + 1}>
            {track.name}
          </button>
          <span class="player__row-artist">
            {track.artists.map((artist, i) => (
              <>
                {i > 0 && ", "}
                <a href={artistUrl(artist.id)} target="_blank" rel="noopener noreferrer">
                  {artist.name}
                </a>
              </>
            ))}
          </span>
          <span class="player__row-time">{clock(track.durationMs)}</span>
        </li>
      ))
    }
  </ul>

    {/*
      The other half of the shuffle, below the rows it rewrites and below the
      embed whose data-start it sets.

      It rewrites the rows the server already rendered instead of rebuilding
      them. Rebuilding would mean re-stamping Astro's scoped-style attribute
      onto every new node, which is the bug documented in the controller below;
      updating text in place cannot hit it.
    */}
    <script is:inline>
      (function () {
        var open = window.__playerOpening;
        if (!open) return;
        delete window.__playerOpening;

        var at = open.block.s + open.offset;
        var embed = document.getElementById("player-embed");
        if (embed) embed.setAttribute("data-start", String(at));

        var rows = document.querySelectorAll("#player-queue .player__row");
        for (var row = 0; row < rows.length; row++) {
          var next = open.block.t[open.offset + 1 + row];
          if (!next) break;
          rows[row].querySelector(".player__row-play").textContent = next.n;
          open.into(rows[row].querySelector(".player__row-artist"), next.r);
          rows[row].querySelector(".player__row-time").textContent = open.clock(next.d);
        }
      })();
    </script>

    <p class="player__foot">{playlist.trackCount} tracks, {hours}h {minutes}m</p>
  </div>
</section>

<script>
  /*
    Wraps Spotify's embed rather than replacing it.

    Their iFrame API gives play, pause, seek and a position event, but no next
    or previous, so those are done by loading the next track's uri. That is the
    reason this needs the track list at all, and the reason the list is fetched
    rather than inlined: 35.5KB is not worth spending on visitors who never
    press play.

    Verified against the real controller rather than the docs, which do not list
    all of it: addListener, removeListener, on, off, once, loadUri, loadEntity,
    play, playFromStart, restart, pause, resume, togglePlay, seek, destroy.
  */
  type Track = {
    i: string;
    a: string | null;
    n: string;
    /** [name, spotify artist id] pairs, so each can be its own link. */
    r: [string, string][];
    d: number;
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const embed = $("player-embed");
  if (embed) {
    /* The wrapper, not the embed itself: unhiding the wrapper reveals the
       "playing via" label with it, so the player never appears unattributed. */
    const source = $("player-source");
    const openLink = $<HTMLAnchorElement>("player-open");
    const art = $<HTMLImageElement>("player-art");
    const trackName = $("player-track");
    const artistOut = $("player-artist");
    const seek = $<HTMLInputElement>("player-seek");
    const elapsed = $("player-elapsed");
    const duration = $("player-duration");
    const playBtn = $<HTMLButtonElement>("player-play");
    const playGlyph = $("player-play-glyph");
    const playLabel = $("player-play-label");
    const prevBtn = $<HTMLButtonElement>("player-prev");
    const nextBtn = $<HTMLButtonElement>("player-next");
    const indexOut = $("player-index");
    const queue = $<HTMLUListElement>("player-queue");

    /* How many rows the queue shows, read off the server-rendered list so the
       two cannot disagree when the `listed` prop changes. */
    const QUEUE_ROWS = queue.children.length;

    /*
      Astro scopes this component's styles with a data-astro-cid attribute, so a
      rule written as .player__row compiles to .player__row[data-astro-cid-abc].
      Anything built with createElement is missing that attribute, every scoped
      rule skips it, and the rebuilt rows come back with no layout and native
      browser buttons for titles. It looks like the css broke; the css is fine
      and the selector genuinely does not match.

      So the attribute is read off a row the server rendered and stamped onto
      everything built here. Read rather than hardcoded, because the hash is
      generated per build and would go stale the first time this file changed.
    */
    const CID = [...(queue.querySelector("li")?.attributes ?? [])]
      .map((attribute) => attribute.name)
      .find((name) => name.startsWith("data-astro-cid-"));

    const scoped = <T extends HTMLElement>(element: T): T => {
      if (CID) element.setAttribute(CID, "");
      return element;
    };

    let tracks: Track[] = [];
    let index = 0;

    /*
      Where the shuffle above left the panel, as an index into the full
      playlist rather than into the inlined block. Everything the visitor can
      see is already showing this track, so "play" has to mean this one and the
      queue's offsets have to be measured from it.
    */
    const startIndex = Number(embed.dataset.start) || 0;
    let controller: any = null;
    let paused = true;
    let scrubbing = false;
    /* Ignore position events while a track swap is in flight, or the bar snaps
       back to the outgoing track's position for a frame. */
    let switching = false;

    const clock = (seconds: number) => {
      const s = Math.max(0, Math.round(seconds));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    };

    /*
      How much of the track is behind the thumb, as 0 to 1. The stylesheet
      turns it into a width.

      Derived from the input's own value every time rather than accumulated, so
      the trail cannot get out of step with the dot: seeking backwards shrinks
      it by exactly the path playing forwards grew it, and a track change that
      resets value to 0 resets the trail with it. One source of truth, read
      after every write to value or max.
    */
    const setProgress = () => {
      const max = Number(seek.max);
      const value = Number(seek.value);
      seek.style.setProperty(
        "--progress",
        String(max > 0 ? Math.min(1, Math.max(0, value / max)) : 0),
      );
    };

    /*
      Artist names as links, comma separated, built as nodes rather than a
      string of html. Track and artist names arrive from an API and go straight
      into the page; textContent cannot be talked into becoming markup.
    */
    const artistNodes = (pairs: [string, string][]) => {
      const frag = document.createDocumentFragment();
      pairs.forEach(([name, id], i) => {
        if (i > 0) frag.append(", ");
        const link = scoped(document.createElement("a"));
        link.href = `https://open.spotify.com/artist/${id}`;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = name;
        frag.append(link);
      });
      return frag;
    };

    /*
      The list is a queue, not a table of contents: it always shows what plays
      after whatever is playing, wrapping past the end of the playlist. Rebuilt
      whole on every track change rather than diffed, because six rows is
      nothing and a diff would be more code than it saves.
    */
    const renderQueue = () => {
      if (!tracks.length) return;
      queue.replaceChildren();

      for (let step = 1; step <= QUEUE_ROWS; step++) {
        const at = (index + step) % tracks.length;
        const track = tracks[at];

        const row = scoped(document.createElement("li"));
        row.className = "player__row";

        /*
          A button for the title rather than a click handler on the whole row,
          because the row also carries artist links, and an anchor inside a
          button is invalid and unreachable by keyboard.
        */
        const jump = scoped(document.createElement("button"));
        jump.type = "button";
        jump.className = "player__row-play";
        jump.textContent = track.n;
        jump.addEventListener("click", () => go(at));

        const artists = scoped(document.createElement("span"));
        artists.className = "player__row-artist";
        artists.append(artistNodes(track.r));

        const time = scoped(document.createElement("span"));
        time.className = "player__row-time";
        time.textContent = clock(track.d / 1000);

        row.append(jump, artists, time);
        queue.append(row);
      }
    };

    const paint = (track: Track) => {
      trackName.textContent = track.n;
      artistOut.replaceChildren(artistNodes(track.r));
      if (track.a) art.src = `https://i.scdn.co/image/${track.a}`;
      art.alt = "";
      seek.max = String(Math.round(track.d / 1000));
      seek.value = "0";
      setProgress();
      elapsed.textContent = "0:00";
      duration.textContent = clock(track.d / 1000);
      indexOut.textContent = String(index + 1);
      openLink.href = `https://open.spotify.com/track/${track.i}`;
      renderQueue();
    };

    const setPaused = (value: boolean) => {
      paused = value;
      playGlyph.textContent = value ? ">" : "||";
      playLabel.textContent = value ? "Play" : "Pause";
      playBtn.setAttribute("aria-pressed", String(!value));
    };

    const go = (to: number) => {
      if (!tracks.length) return;
      // Wraps, so the end of the playlist rolls into the start rather than
      // stopping dead. This is the thing that makes it play continuously.
      index = (to + tracks.length) % tracks.length;
      const track = tracks[index];
      switching = true;
      paint(track);
      controller?.loadUri(`spotify:track:${track.i}`);
      // loadUri does not start playback on its own. The gesture that got us
      // here still counts, so this is not blocked by autoplay policy.
      window.setTimeout(() => {
        controller?.play();
        switching = false;
      }, 400);
      setPaused(false);
    };

    let starting = false;

    const loadApi = () =>
      new Promise<any>((resolve, reject) => {
        if ((window as any).__spotifyIframeApi) return resolve((window as any).__spotifyIframeApi);
        (window as any).onSpotifyIframeApiReady = (api: any) => {
          (window as any).__spotifyIframeApi = api;
          resolve(api);
        };
        const tag = document.createElement("script");
        tag.src = "https://open.spotify.com/embed/iframe-api/v1";
        tag.async = true;
        tag.onerror = () => reject(new Error("Spotify iframe API did not load"));
        document.head.append(tag);
      });

    const start = async (from = 0) => {
      if (starting || controller) return;
      starting = true;
      playLabel.textContent = "Loading";

      try {
        const [api, list] = await Promise.all([
          loadApi(),
          fetch("/playlist.json").then((r) => r.json() as Promise<Track[]>),
        ]);
        tracks = list;
        index = (startIndex + from) % tracks.length;

        source.hidden = false;
        await new Promise<void>((resolve) => {
          api.createController(
            embed,
            { uri: `spotify:track:${tracks[index].i}`, width: "100%", height: "80" },
            (ctrl: any) => {
              controller = ctrl;

              ctrl.addListener("playback_update", (event: any) => {
                const data = event?.data;
                if (!data || switching) return;

                if (!scrubbing && typeof data.position === "number") {
                  const seconds = data.position / 1000;
                  seek.value = String(Math.round(seconds));
                  setProgress();
                  elapsed.textContent = clock(seconds);
                }
                if (typeof data.duration === "number" && data.duration > 0) {
                  seek.max = String(Math.round(data.duration / 1000));
                  /* max moved, so the same value is now a different fraction. */
                  setProgress();
                  duration.textContent = clock(data.duration / 1000);

                  /*
                    The embed has no "track ended" event, so the end is inferred
                    from the position reaching the duration. Somebody on a
                    preview hits it at thirty seconds and somebody signed in to
                    Premium hits it at the end of the song. Either way the next
                    track follows, which is what makes it continuous for both.
                  */
                  if (data.position >= data.duration - 900 && data.position > 0) go(index + 1);
                }
                if (typeof data.isPaused === "boolean") setPaused(data.isPaused);
              });

              resolve();
            },
          );
        });

        prevBtn.disabled = false;
        nextBtn.disabled = false;
        seek.disabled = false;
        paint(tracks[index]);
        controller.play();
        setPaused(false);
      } catch {
        playLabel.textContent = "Play";
        starting = false;
        source.hidden = true;
        trackName.textContent = "Spotify would not load";
        artistOut.textContent = "Open the playlist on Spotify instead";
        return;
      }
      starting = false;
    };

    /*
      The server-rendered rows carry an offset rather than an index, so a click
      before the track list has loaded still means the right thing: start
      playing, that many tracks along from where we are.
    */
    queue.querySelectorAll<HTMLButtonElement>("[data-jump]").forEach((button) => {
      button.addEventListener("click", () => {
        const offset = Number(button.dataset.jump);
        if (!tracks.length) return void start(offset);
        go(index + offset);
      });
    });

    playBtn.addEventListener("click", () => {
      if (!controller) return void start();
      controller.togglePlay();
      setPaused(!paused);
    });

    prevBtn.addEventListener("click", () => {
      /* Restart the current track first, then step back, which is what every
         other transport control does and what a listener expects. */
      const at = Number(seek.value);
      if (at > 3) return void controller?.seek(0);
      go(index - 1);
    });

    nextBtn.addEventListener("click", () => go(index + 1));

    /* Tracks the drag itself, so the trail follows the thumb under the cursor
       rather than waiting for the next position event from the embed. This is
       also the path that shrinks it when the drag goes backwards. */
    seek.addEventListener("input", () => {
      scrubbing = true;
      setProgress();
      elapsed.textContent = clock(Number(seek.value));
    });

    seek.addEventListener("change", () => {
      /* seek() takes seconds, which is the one unit mismatch in this API: the
         position that arrives on playback_update is milliseconds. */
      controller?.seek(Number(seek.value));
      scrubbing = false;
    });
  }
</script>

