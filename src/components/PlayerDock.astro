      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  /* On a phone the dock would cover the content it is floating over, so it
     spans the width and sits flat against the foot of the viewport instead. */
  @media (max-width: 30rem) {
    .dock {
      right: var(--s2);
      left: var(--s2);
      width: auto;
    }

    /*
      At this width the dock above is no longer a small window tucked in a
      corner, it spans the page, so whatever it is covering is genuinely
      underneath it rather than beside it. Measured at 375 before this rule:
      expanded, the dock covered .entry, an .entry__title and a link, 284px
      of an 800px viewport; collapsed, at 57px, it still covered one card.

      --dock-space is written by the script above, in pixels, and is 0 until
