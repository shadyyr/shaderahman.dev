---
import { render, type CollectionEntry } from "astro:content";
import { emphasize, formatAward } from "../lib/format";
import Tag from "./Tag.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  /** Compact form for the home page: summary and links only. */
  compact?: boolean;
  /** Depth in the page outline. Never skip a level to get a size you like. */
  level?: 2 | 3;
}

const { entry, compact = false, level = 2 } = Astro.props;
const { data } = entry;
const Heading = `h${level}` as "h2" | "h3";

const { Content } = await render(entry);
const hasBody = !compact && entry.body != null && entry.body.trim().length > 0;
---

<li class="entry">
  <div class="entry__head">
    {/* The award is a second line of the title, in the experience card's
        company styling: same face and size, a step dimmer than the name. As a
        micro label it read as an afterthought, and inline after a "·" it
        crowded the name. The head row aligns on the first baseline, so the
        period still lines up with the name rather than the award. */}
    <Heading class="entry__title">
      {data.title}
      {
        data.award && (
          <span class="entry__org award">
            {formatAward(data.award)}
            <span class="award__star" aria-hidden="true">★</span>
          </span>
        )
      }
    </Heading>
    <p class="entry__meta">{data.period}</p>
  </div>

  {/* Through emphasize, the same as an experience bullet: `**` around the
      figure that carries the claim, and nothing else honoured. It escapes
      first and applies the markers after, so a stray `<` in a summary renders
      as a character rather than as markup. */}
  <p class="entry__summary" set:html={emphasize(data.summary)} />

  {
    !compact && data.highlights.length > 0 && (
      <dl class="highlights">
        {data.highlights.map((highlight) => (
          <div class="highlight">
            <dt>{highlight.label}</dt>
            <dd set:html={emphasize(highlight.detail)} />
          </div>
        ))}
      </dl>
    )
  }

  {
    data.tech.length > 0 && (
      <ul class="tags">
        {data.tech.map((item) => (
          <Tag name={item} />
        ))}
      </ul>
    )
  }

  {
    hasBody && (
      <div class="entry__detail prose">
        <Content />
      </div>
    )
  }

  {
    !compact && data.collaborators.length > 0 && (
      <p class="collab">
        <span class="collab__label">Built with</span>{" "}
        {data.collaborators.map((person, index) => (
          <>
            {index > 0 && ", "}
            {person.url ? (
              <a href={person.url} target="_blank" rel="noopener noreferrer">
                {person.name}
              </a>
            ) : (
              <span>{person.name}</span>
            )}
          </>
        ))}
      </p>
    )
  }

  {
    data.links.length > 0 && (
      <p class="entry__links">
        {data.links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </p>
    )
  }
</li>

<style>
  /* The star trails the prize name, so the name starts on the same edge as
     the project name above it. */
  .award {
    display: block;
    margin-top: var(--s1);
  }

  /* The ★ glyph draws small next to letters at the same size. line-height: 1
     keeps the larger glyph from making its line taller than the name's. */
  .award__star {
    margin-left: 0.55ch;
    font-size: 1.75em;
    line-height: 0;
    vertical-align: -0.05em;
  }

  .highlights {
    margin: var(--s4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .highlight dt {
    font-weight: 600;
    color: var(--amber-max);
  }

  .highlight dd {
    margin: 0;
    padding-left: var(--s4);
    border-left: 1px solid var(--amber-ghost);
    color: var(--amber);
  }

  .collab {
    margin-top: var(--s4);
    font-size: var(--text-sm);
    color: var(--amber-dim);
  }

  .collab__label {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }

  .prose :global(p) {
    color: var(--amber-dim);
  }

  .prose :global(p + p) {
    margin-top: var(--s3);
  }
</style>
