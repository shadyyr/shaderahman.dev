---
import { getCollection } from "astro:content";
import OsLayout from "../layouts/OsLayout.astro";
import PageHead from "../components/PageHead.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import Tag from "../components/Tag.astro";
import { byRecency, formatRange } from "../lib/format";
import { EDUCATION } from "../lib/site";

const entries = (await getCollection("experience"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => byRecency(a.data, b.data));
---

<OsLayout
  title="Experience"
  description="Roles I've held, what each one was actually for, and what changed while I was there."
  path="/experience"
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Experience", path: "/experience" },
  ]}
>
  <PageHead
    eyebrow="Work history"
    heading="Experience"
    lede="Every role in reverse order. Starred tags are the ones that carried the work, not everything I touched."
  />

  <ul class="entries">
    {entries.map((entry) => <ExperienceEntry entry={entry} level={2} />)}
  </ul>

  <section class="panel education" aria-labelledby="education-heading">
    <h2 class="panel__title" id="education-heading">Education</h2>
    <p class="education__school">
      <a href={EDUCATION.url}>{EDUCATION.school}</a>
    </p>
    <p class="education__meta">
      {EDUCATION.degree} · GPA {EDUCATION.gpa} ·{" "}
      {formatRange(EDUCATION.start, EDUCATION.end)} · {EDUCATION.location}
    </p>
    <p class="education__label">Coursework</p>
    <ul class="tags">
      {EDUCATION.coursework.map((course) => <Tag name={course} />)}
    </ul>
  </section>
</OsLayout>

<style>
  .education {
    margin-top: var(--s10);
  }

  .education__school {
    font-size: var(--text-lg);
    color: var(--amber-max);
    font-weight: 600;
  }

  .education__meta {
    margin-top: var(--s1);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }

  .education__label {
    margin-top: var(--s4);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }
</style>
