---
import { getCollection } from "astro:content";
import OsLayout from "../layouts/OsLayout.astro";
import PageHead from "../components/PageHead.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import ExperienceGroup from "../components/ExperienceGroup.astro";
import Tag from "../components/Tag.astro";
import { byRecency, formatRange, groupByOrg } from "../lib/format";
import { EDUCATION } from "../lib/site";

const entries = (await getCollection("experience"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => byRecency(a.data, b.data));

// Consecutive roles at one organisation share a card, so a promotion track
// reads as one thing. A run of one renders exactly as it always did.
const units = groupByOrg(entries, (entry) => entry.data);
---

<OsLayout
  title="Experience"
  description="Roles I've held, what each one was actually for, and what changed while I was there."
  path="/experience"
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Experience", path: "/experience" },
  ]}
>
  <PageHead
    eyebrow="Work history"
    heading="Experience"
    lede="Every role in reverse order. Starred tags are the ones that carried the work, not everything I touched."
  />

  <ul class="entries">
    {
      units.map((roles) =>
        roles.length > 1 ? (
          <ExperienceGroup roles={roles} />
        ) : (
          <ExperienceEntry entry={roles[0]} level={2} />
        ),
      )
    }
  </ul>

  {/*
    A standing section title over a panel, the same shape as "What's on my
    playlist" and "Selected work" on the home page, rather than a label notched
    into the panel's own border. Education is a section of this page, not an
    aside inside it, and it now says so at the same size as the other two.
  */}
  <section class="education" aria-labelledby="education-heading">
    <h2 class="section-title" id="education-heading">Education</h2>

    <div class="panel">
      <p class="education__school">
        <a href={EDUCATION.url}>{EDUCATION.school}</a>
      </p>
      <p class="education__meta">
        {EDUCATION.degree} · GPA {EDUCATION.gpa} ·{" "}
        {formatRange(EDUCATION.start, EDUCATION.end)} · {EDUCATION.location}
      </p>
      <p class="education__label">Coursework</p>
      <ul class="tags">
        {EDUCATION.coursework.map((course) => <Tag name={course} />)}
      </ul>
    </div>
  </section>
</OsLayout>

<style>
  .education {
    margin-top: var(--s10);
  }

  .education__school {
    font-size: var(--text-lg);
    color: var(--amber-max);
    font-weight: 600;
  }

  .education__meta,
  .education__label {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }

  .education__meta {
    margin-top: var(--s1);
  }

  .education__label {
    margin-top: var(--s4);
  }
</style>
