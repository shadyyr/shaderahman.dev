---
import OsLayout from "../layouts/OsLayout.astro";
import PageHead from "../components/PageHead.astro";
import { DESIGN } from "../data/design";
import assets from "../data/design-assets.json";

/*
  Two halves, joined here. The facts a script cannot read live in design.ts;
  the measured ones, page dimensions and slide counts, are generated into
  design-assets.json by `npm run design`. A piece with no generated half is
  dropped rather than rendered broken, which is what happens if someone adds an
  entry and forgets to rerun the script.
*/
const pieces = DESIGN.filter((piece) => piece.slug in assets)
  .map((piece) => ({ ...piece, ...(assets as Record<string, any>)[piece.slug] }))
  .sort((a, b) => b.date.localeCompare(a.date));

const missing = DESIGN.filter((piece) => !(piece.slug in assets)).map((p) => p.slug);
if (missing.length) {
  console.warn(`[design] no generated assets for: ${missing.join(", ")}. Run npm run design.`);
}

/* A banner is far wider than it is tall and looks absurd in a portrait cell,
   so it takes the full row instead. 2 is well clear of the 1.04 the widest
   non-banner piece measures. */
const isBanner = (ratio: number) => ratio >= 2;
---

<OsLayout
  title="Design"
  description="Graphic design for the Bengali Student Association and Knight Hacks: event flyers, Instagram carousels, banners, and application graphics."
  path="/design"
  crumbs={[{ name: "Design", path: "/design" }]}
>
  <PageHead eyebrow="Made things" heading="Design">
    <p class="pagehead__lede">
      Most of these are from two organizations: the Bengali Student Association,
      where I ran marketing before becoming president, and Knight Hacks, where I
      design graphics for their annual hackathon. Designs include event flyers,
      Instagram carousels, form banners, and application graphics. Open one of
      the designs to page through every slide.
    </p>
  </PageHead>

  <ul class="gallery">
    {
      pieces.map((piece) => (
        <li class:list={["piece", isBanner(piece.ratio) && "piece--wide"]}>
          {/*
            A real link to the first page, so this works with JavaScript off:
            the colophon promises the rest of the site does. The script below
            intercepts the click and opens the viewer instead, and it leaves
            modified clicks alone so "open in new tab" still does that.
          */}
          <a
            class="piece__link"
            href={piece.pages[0].file}
            data-pages={piece.pages.map((p: any) => p.file).join(",")}
            data-title={piece.title}
          >
            <img
              class="piece__img"
              src={piece.thumb.file}
              srcset={`${piece.thumb.file} ${piece.thumb.width}w, ${piece.pages[0].file} ${piece.pages[0].width}w`}
              sizes="(min-width: 70rem) 22vw, (min-width: 40rem) 45vw, 92vw"
              width={piece.pages[0].width}
              height={piece.pages[0].height}
              style={`aspect-ratio: ${piece.ratio}`}
              alt={`${piece.title}, designed for ${piece.org}`}
              loading="lazy"
              decoding="async"
            />
          </a>

          {/*
            Blue only when it goes somewhere. A piece with a post links its
            title to Instagram; one without renders the same words as plain
            amber text, because the palette rule here is that blue means
            actionable and nothing else.
          */}
          {piece.post ? (
            <a class="piece__title piece__title--link" href={piece.post}>
              {piece.title}
            </a>
          ) : (
            <span class="piece__title">{piece.title}</span>
          )}

          <p class="piece__org">{piece.org}</p>
          {piece.slides > 1 && <p class="piece__slides">{piece.slides} slides</p>}
        </li>
      ))
    }
  </ul>

  {/*
    One viewer for the whole page, filled on open, rather than sixteen dialogs
    sitting in the DOM holding markup nobody has asked for yet.

    A real <dialog> rather than a div with a high z-index. showModal() brings
    the backdrop, the focus trap, inertness for everything behind it and
    Escape-to-close with no code, and every one of those is a thing a
    hand-rolled overlay gets wrong.
  */}
  <dialog class="viewer" id="viewer" aria-label="Design viewer">
    <figure class="viewer__stage">
      {/*
        The controls live inside this box, not in the dialog, and that is the
        whole mechanism. .viewer__frame shrink-wraps whatever picture is in it,
        so positioning the buttons against it puts them beside the artwork
        rather than out at the window's edges. A 4:1 banner and a tall story
        post are wildly different sizes and both get their arrows exactly one
        gutter from their own edge, with no measuring in script.
      */}
      <div class="viewer__frame">
        <img class="viewer__img" id="viewer-img" alt="" />

        <button class="viewer__close" id="viewer-close" type="button" aria-label="Close viewer">
          <span aria-hidden="true">&#215;</span>
        </button>
        <button class="viewer__step viewer__step--prev" id="viewer-prev" type="button" aria-label="Previous slide">
          <span aria-hidden="true">&#8249;</span>
        </button>
        <button class="viewer__step viewer__step--next" id="viewer-next" type="button" aria-label="Next slide">
          <span aria-hidden="true">&#8250;</span>
        </button>
      </div>

      <figcaption class="viewer__bar">
        <span class="viewer__label" id="viewer-label" />
        <span class="viewer__count" id="viewer-count" />
      </figcaption>
    </figure>
  </dialog>
</OsLayout>

<script>
  /*
    The viewer, and the one thing about this site that decides whether it keeps
    working: ClientRouter replaces the whole document on every navigation, and
    a module script runs once for the visit rather than once per page. So every
    element here is looked up fresh inside setup(), and setup() runs again on
    astro:page-load. A reference captured at module scope points at a detached
    node after the first client-side navigation, and the failure is silent:
    clicking does nothing and nothing appears in the console. That exact shape
    of bug has already been fixed twice in this repo.

    Listeners go on elements that are themselves replaced by the swap, never on
    document, so re-running setup() cannot stack duplicates: the old elements
    are garbage along with their handlers.
  */
  function setup() {
    const dialog = document.getElementById("viewer") as HTMLDialogElement | null;
    if (!dialog) return;

    const img = document.getElementById("viewer-img") as HTMLImageElement;
    const label = document.getElementById("viewer-label") as HTMLElement;
    const count = document.getElementById("viewer-count") as HTMLElement;
    const prev = document.getElementById("viewer-prev") as HTMLButtonElement;
    const next = document.getElementById("viewer-next") as HTMLButtonElement;
    const close = document.getElementById("viewer-close") as HTMLButtonElement;

    let pages: string[] = [];
    let title = "";
    let index = 0;
    let opener: HTMLElement | null = null;

    /* Wraps in both directions. At the end of a seven slide carousel the next
       arrow going back to the first slide is friendlier than a dead control,
       and there is nowhere else for it to go. */
    const show = (to: number) => {
      index = (to + pages.length) % pages.length;
      img.src = pages[index];
      img.alt = `${title}, slide ${index + 1} of ${pages.length}`;
      count.textContent = pages.length > 1 ? `${index + 1} / ${pages.length}` : "";
    };

    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-pages]")) {
      link.addEventListener("click", (event) => {
        /* A middle click, or any modifier, is someone asking for a new tab.
           Hijacking that is the rudest thing an overlay can do. */
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();

        pages = (link.dataset.pages ?? "").split(",").filter(Boolean);
        if (!pages.length) return;
        title = link.dataset.title ?? "";
        label.textContent = title;
        opener = link;

        /* A single page piece has nothing to step through, so the arrows go
           rather than sit there disabled. A control that cannot do anything is
           still a promise the interface is making. */
        const many = pages.length > 1;
        prev.hidden = !many;
        next.hidden = !many;

        show(0);
        dialog.showModal();
      });
    }

    prev.addEventListener("click", () => show(index - 1));
    next.addEventListener("click", () => show(index + 1));
    close.addEventListener("click", () => dialog.close());

    /* Arrow keys, because anyone given left and right controls will try them.
       Escape is already handled by showModal() and needs nothing here. */
    dialog.addEventListener("keydown", (event) => {
      if (pages.length < 2) return;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(index + 1);
      }
    });

    /*
      Anywhere in the dark closes it.

      Testing for `event.target === dialog` is the obvious version and it is
      wrong here: the stage fills the dialog, so a click on what looks like
      bare backdrop actually lands on the stage and the dialog never sees
      itself as the target. Asking whether the click was inside the picture's
      own box is the question that was always meant, and it keeps working
      however the layers inside change.

      The caption is excluded too. It sits outside the frame, and closing the
      viewer because someone clicked the title of the thing they are looking at
      would read as a bug.
    */
    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (!target.closest(".viewer__frame, .viewer__bar")) dialog.close();
    });

    /* Focus goes back where it came from. Without this it lands on <body> and
       a keyboard reader loses their place in a grid of sixteen. */
    dialog.addEventListener("close", () => {
      opener?.focus();
      /* Dropped so a closed viewer is not holding the last image in memory,
         and so a reopen cannot flash the previous piece before the new one
         decodes. */
      img.removeAttribute("src");
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  /*
    Ratios here run from 0.56 on a story post to 4.0 on a form banner, so
    nothing is cropped to a common shape: each cover keeps its own aspect ratio
    and the row is as tall as its tallest member. Cropping a designer's
    compositions to tidy up a grid would be the wrong trade on this page in
    particular.

    16rem rather than the 24rem the other grids use, because these are images
    rather than blocks of text: the floor is about how small a cover can get
    and still read, not about a line length. It gives three columns at the
    widest the content column gets and collapses to one on a phone. The min()
    is the same load-bearing guard as everywhere else, without which minmax
    treats the floor as hard and the grid hangs off the side of a narrow
    screen.
  */
  .gallery {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s6);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    align-items: start;
  }

  /* A 4:1 banner in a portrait cell would be a sliver with a lot of air around
     it. Full width is closer to how it is actually used. */
  .piece--wide {
    grid-column: 1 / -1;
  }

  .piece__link {
    display: block;
  }

  .piece__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--amber-ghost);
    background: var(--bg-inset);
  }

  .piece__title {
    display: block;
    margin-top: var(--s3);
    font-size: var(--text-sm);
    color: var(--amber);
  }

  /* Only the linked ones are blue, and only they carry the underline on hover.
     A title with no post behind it stays amber and inert. */
  .piece__title--link {
    color: var(--blue);
    text-decoration: none;
  }

  .piece__title--link:hover,
  .piece__title--link:focus-visible {
    text-decoration: underline;
  }

  /* The organisation and the slide count are separate lines, not a wrapped
     row. They answer different questions and reading "Knight Hacks 7 slides"
     as one run made the count look like part of the client's name. */
  .piece__org,
  .piece__slides {
    margin-top: var(--s1);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }

  /* ------------------------------------------------------------- viewer -- */

  /*
    --gutter is the one number this viewer runs on. It reserves the space, in
    the dialog's padding, and it places every control, in the offsets below, so
    the two can never drift apart. 44px of control plus 12px of air is what
    puts a button clear of the artwork without it floating off on its own.
  */
  .viewer {
    --gutter: calc(var(--tap) + var(--s3));

    max-width: 100%;
    max-height: 100%;
    width: 100%;
    height: 100%;
    padding: var(--gutter);
    border: 0;
    background: none;
    overflow: hidden;
  }

  /* Darker than the page rather than a wash of colour over it. The point is
     that everything behind stops competing with the picture. */
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.82);
  }

  .viewer__stage {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
  }

  /*
    Shrink-wrapped to the picture. inline-block rather than a flex or grid
    child, because those stretch to their container and this has to be exactly
    as wide as the image currently is, whatever that turns out to be.

    line-height: 0 because an inline-block otherwise reserves a few pixels of
    descender space under the image, and the close button is positioned off
    this box's edges: a phantom strip at the bottom would make the offsets
    quietly asymmetric.
  */
  .viewer__frame {
    position: relative;
    display: inline-block;
    max-width: 100%;
    line-height: 0;
  }

  /*
    Bounded by the window rather than by its own dimensions, so a 4320px tall
    carousel page and a 400px tall banner both land inside without either being
    scaled up past what was rendered.

    Two gutters for the dialog's own padding, then 4rem for the caption and the
    gap above it. dvh is declared second so browsers that have it use the real
    visible height, and the ones that do not fall back to vh rather than to
    nothing.
  */
  .viewer__img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - (2 * var(--gutter)) - 4rem);
    max-height: calc(100dvh - (2 * var(--gutter)) - 4rem);
    width: auto;
    height: auto;
    border: 1px solid var(--amber-faint);
    background: var(--bg-inset);
  }

  .viewer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--s2) var(--s4);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }

  /*
    Controls are chrome, so they are amber, and they are the exception that
    proves the palette rule rather than a break in it: blue marks a link to
    somewhere else, and none of these leave the page.
  */
  /*
    Absolute against .viewer__frame, so every offset below is measured from the
    picture's own edge rather than the window's.

    Controls are chrome, so they are amber, and they are the exception that
    proves the palette rule rather than a break in it: blue marks a link to
    somewhere else, and none of these leave the page.
  */
  .viewer__close,
  .viewer__step {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0;
    border: 1px solid var(--amber-faint);
    background: var(--bg-panel);
    color: var(--amber-hi);
    font-family: var(--font-display);
    line-height: 1;
    cursor: pointer;
  }

  .viewer__close:hover,
  .viewer__step:hover,
  .viewer__close:focus-visible,
  .viewer__step:focus-visible {
    border-color: var(--amber);
    color: var(--amber-max);
  }

  /* Directly above the picture's top-right corner. `bottom: 100%` is the
     picture's top edge, so the gap is the same --s3 the arrows use. */
  .viewer__close {
    bottom: calc(100% + var(--s3));
    right: 0;
    font-size: 1.5rem;
  }

  /* Centred on the picture, not on the window, so a short banner gets its
     arrows level with itself instead of stranded halfway down the screen. */
  .viewer__step {
    top: 50%;
    translate: 0 -50%;
    font-size: 2rem;
  }

  /* right: 100% is the picture's left edge, left: 100% its right edge, so both
     arrows sit one --s3 clear of the artwork whatever size it is. */
  .viewer__step--prev {
    right: calc(100% + var(--s3));
  }

  .viewer__step--next {
    left: calc(100% + var(--s3));
  }

  .viewer__step[hidden] {
    display: none;
  }

  /*
    On a phone a gutter either side would cost 112px of a 375px screen, which
    is most of what the artwork needs. The arrows drop under the picture and
    line up with its own left and right edges, so they still belong to it, and
    the picture gets the full width back.
  */
  @media (max-width: 40rem) {
    .viewer {
      padding: var(--gutter) var(--s3) calc(var(--gutter) + 2.5rem);
    }

    .viewer__step {
      top: calc(100% + var(--s3));
      translate: none;
    }

    .viewer__step--prev {
      right: auto;
      left: 0;
    }

    .viewer__step--next {
      left: auto;
      right: 0;
    }

    .viewer__img {
      max-height: calc(100vh - 13rem);
      max-height: calc(100dvh - 13rem);
    }

    /*
      The arrows are out of flow, so the caption rides up into the same band
      and sits between them, which is a good use of the height a phone does not
      have to spare. It only works while the caption stays clear of them: this
      reserves an arrow's width at each end so a long title wraps instead of
      running underneath one.
    */
    .viewer__bar {
      padding-inline: calc(var(--tap) + var(--s3));
    }
  }
</style>
