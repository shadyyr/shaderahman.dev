---
import { getCollection } from "astro:content";
import OsLayout from "../layouts/OsLayout.astro";
import PageHead from "../components/PageHead.astro";
import ProjectEntry from "../components/ProjectEntry.astro";

// Newest first, nothing else. Same-month projects carry a day in `date`
// so the order between them is decided, not left to file order.
const entries = (await getCollection("projects"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<OsLayout
  title="Projects"
  description="Things I've built, what each one was for, what broke along the way, and where to read the source."
  path="/projects"
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Projects", path: "/projects" },
  ]}
>
  <PageHead
    eyebrow="Built things"
    heading="Projects"
    lede="Fewer entries, written properly. Each one says what it does and what was hard."
  />

  <ul class="entries">
    {entries.map((entry) => <ProjectEntry entry={entry} level={2} />)}
  </ul>
</OsLayout>
