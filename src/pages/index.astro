---
import { getCollection } from "astro:content";
import OsLayout from "../layouts/OsLayout.astro";
import PageHead from "../components/PageHead.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import ExternalKey from "../components/ExternalKey.astro";
import PlaylistPanel from "../components/PlaylistPanel.astro";
import { SITE } from "../lib/site";
import { findResume } from "../lib/resume";
import { byRecency } from "../lib/format";

const experience = (await getCollection("experience"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => byRecency(a.data, b.data));

const featured = (await getCollection("projects"))
  .filter((entry) => !entry.data.draft && entry.data.featured)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const resume = findResume();

const buildDate = new Date().toISOString().slice(0, 10);
---

<OsLayout
  title="Home"
  description={SITE.description}
  path="/"
  isHome
>
  <PageHead eyebrow={`${SITE.system.label} · ready`} heading={SITE.name} tight>
    <p class="tagline">{SITE.role} · {SITE.location}</p>
  </PageHead>

  <div class="stack--loose stack">
    <section aria-labelledby="intro-heading" class="intro">
      <h2 class="visually-hidden" id="intro-heading">Introduction</h2>

      <div class="intro__text">
        <p>
          I'm a computer engineering student at UCF. Right now, I'm a solutions
          engineer intern at PeakActivity and president of the Bengali Student
          Association. I'm also doing graphic design for Knight Hacks, mostly
          Instagram posts and merchandise, plus this year's landing page. Most
          of what I build sits between full-stack web work and whichever API
          I've gotten curious about that month.
        </p>
        <p>
          I started out as a CS major and switched after my first semester. Now
          don't get me wrong, I still love CS and writing code, but I wanted to
          know what's underneath the code, what it actually does, and how it
          does it. Computer engineering is where that question gets answered.
          It's definitely a struggle to learn the electrical portion of it, but
          it's definitely worth it.
        </p>
      </div>

      {/*
        Unfiltered, exactly like the album covers in the player below: a border,
        object-fit, and nothing else. The site's own CRT overlay passes over it
        and does the rest.

        It was an amber duotone for a while, on the reasoning that a colour
        photograph would fight the palette at this size where a 128px cover does
        not. He looked at it on the page and disagreed, which settles it: the
        overlay was reading as orange paint over the photograph rather than as
        part of the interface. Do not put it back without asking.
      */}
      <div class="intro__photo">
        <img
          src="/portrait.webp"
          width="768"
          height="960"
          alt="Shade Rahman, smiling, by the water at sunset"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="keys">
        <ExternalKey href={SITE.socials.github} label="GitHub" hint="G" />
        <ExternalKey href={SITE.socials.linkedin} label="LinkedIn" hint="L" />
        {
          resume.available ? (
            <ExternalKey href={resume.href} label="Résumé (PDF)" hint="R" />
          ) : (
            <span
              class="key key--off"
              title={`Drop the PDF at public/resume/${resume.expected}`}
            >
              Résumé (not uploaded yet)
            </span>
          )
        }
      </div>
    </section>

    <PlaylistPanel />

    {
      featured.length > 0 && (
        <section aria-labelledby="featured-heading">
          <h2 class="section-title" id="featured-heading">Selected work</h2>
          <ul class="entries">
            {featured.map((entry) => (
              <ProjectEntry entry={entry} compact level={3} />
            ))}
          </ul>
          <p class="more">
            <a href="/projects">Everything else →</a>
          </p>
        </section>
      )
    }

    <section class="panel panel--plain colophon" aria-labelledby="colophon-heading">
      <h2 class="panel__title" id="colophon-heading">Colophon</h2>
      <p>
        Static HTML built with <a href="https://astro.build">Astro</a> and
        hand-written CSS. No framework runtime, no analytics, no trackers of
        mine. The player is the one exception: press play and it loads
        Spotify's embed, which is theirs and sets its own cookies. Leave it
        alone and nothing third-party is requested except the album art.
        Everything else here works with JavaScript switched off.
      </p>
      <p>
        Display type is <a href="https://departuremono.com">Departure Mono</a>{" "}
        by Helena Zhang; body type is IBM Plex Mono. Both are licensed under the
        SIL Open Font License and served from this domain.
      </p>
      <p class="colophon__meta">
        <span>Last built {buildDate}</span>
        <a href={`${SITE.socials.github}/shaderahman.dev`}>Source</a>
      </p>
    </section>
  </div>
</OsLayout>

<style>
  /* "Computer Engineering Student · Orlando, FL". A role title and a city,
     both of which have their own capitalisation. Left alone.

     11px, not 13. Departure Mono is drawn for multiples of 11 and its author
     asks for it to be set that way; this was the one element on the site
     setting the display face at 13px, where the pixel grid it is drawn on does
     not land on whole pixels. It now matches the eyebrow above the heading,
     which is the same kind of line doing the same job. */
  .tagline {
    margin-top: var(--s3);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--amber-dim);
  }

  /*
    The two paragraphs on the left, the photograph on the right, the buttons on
    their own row underneath. It wraps
    rather than switching on a breakpoint, because the width available here does
    not follow the viewport: the sidebar arrives at 56rem and takes 240px with
    it, so the row measures 846px at a 896px viewport and 607px at 897px, wider
    on the smaller screen. No single min-width describes that, and a flex line
    breaks on the space it actually has.

    DOM order is prose, photograph, buttons, with no `order` anywhere, so what a
    screen reader reads and what the eye follows cannot come apart.
  */
  .intro {
    display: flex;
    flex-wrap: wrap;
    /* stretch, not flex-start: it is what makes the picture end exactly where
       the prose does, rather than running on past it. */
    align-items: stretch;
    gap: var(--s6) var(--s8);
    /*
      A query container, because the rule below has to know whether the row
      wrapped and no media query can tell it. The width here does not track the
      viewport: the sidebar arrives at 56rem, so this row is 846px at a 896px
      viewport and 607px at 897px. Asking the row how wide it actually is
      answers the question the viewport cannot.
    */
    container-type: inline-size;
  }

  /* 28rem is about 44 characters to the line at 17px, as narrow as the prose is
     worth reading beside a picture, so it is also where the row stacks. */
  .intro__text {
    flex: 1 1 28rem;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  /*
    Beside the two paragraphs and bounded by them. It flanked the buttons too at
    first and stood 480px against their 451, so it finished below the prose and
    the whole block looked like it had slipped down a few pixels. The buttons
    are back on their own full-width row and the picture takes its height from
    the paragraphs.

    A share of the row rather than a fixed width, capped at 22rem so it cannot
    start dictating the page.
  */
  .intro__photo {
    position: relative;
    flex: 0 1 20rem;
    max-width: 22rem;
    min-width: min(14rem, 100%);
    margin-inline: auto;
    border: 1px solid var(--amber-ghost);
    background: var(--bg-inset);
    line-height: 0;
    overflow: hidden;
  }

  /*
    Stacked, the picture carries its own 4:5 shape, because nothing else is on
    the line to give it a height.
  */
  .intro__photo {
    aspect-ratio: 4 / 5;
  }

  .intro__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  /*
    Side by side, the prose sets the height and the picture follows.

    This is the whole point of the container query, and getting it wrong was a
    real bug rather than a nicety. With an aspect-ratio the picture has an
    intrinsic 400px height, and a flex line is as tall as its tallest item, so
    the picture was setting the row and the prose was being stretched to match
    it. Measured at 1440: the text box was 400px tall around 342px of prose,
    leaving 57px of dead space inside it and pushing the buttons 81px clear of
    the last line. At 1280 the prose happened to be 397px and it looked fine,
    which is exactly how this survived a measurement pass.

    Dropping the ratio and taking the image out of flow leaves the picture with
    no height of its own, so the line is sized by the prose alone and stretch
    hands that height back to the picture. 50rem is where the row stops
    wrapping: 28rem of prose plus 20rem of picture plus the 2rem gap.
  */
  @container (min-width: 50rem) {
    .intro__photo {
      aspect-ratio: auto;
    }

    .intro__photo img {
      position: absolute;
      inset: 0;
    }
  }

  .intro p {
    font-size: var(--text-lg);
    color: var(--amber);
  }

  /* Its own full-width row beneath both columns, which is where it was before
     the picture arrived and where it belongs: the buttons are about the page,
     not about the paragraph they happen to sit next to. */
  .keys {
    flex-basis: 100%;
  }

  .more {
    margin-top: var(--s4);
    font-size: var(--text-sm);
  }

  /* Full width of the panel, via the "a box is never capped" rule in
     global.css. This was two columns for a while, which kept every line inside
     the measure; he looked at it and wanted the paragraph running the full
     width of the box instead, and then wanted the same everywhere, which is
     what put that rule in global.css rather than here. */
  .colophon p {
    color: var(--amber-dim);
    font-size: var(--text-sm);
  }

  /* 12px, which tracks this block's 13px type rather than the intro's 17px.
     The two are deliberately different numbers and look even because of it. */
  .colophon p + p {
    margin-top: var(--s3);
  }

  /*
    A footer rule, which is what makes the panel read as filled rather than as
    a short line adrift under two columns: the two paragraphs end ragged, at
    different depths, and this closes them off across the full width.

    Both ends are anchored, the way the status bar at the foot of the page
    anchors its hints and its clock. That is also why the "·" that used to
    separate these two is gone; a separator between two things at opposite ends
    of a rule reads as a mistake.

    The selector is `.colophon .colophon__meta`, not `.colophon__meta`, and
    that is not a flourish. `.colophon p` above is one class plus one type and
    outranks a single class, so this block's `font-size` silently lost to it
    and the line had been shipping at 13px, two steps up from the 11px every
    other label on the site uses.
  */
  .colophon .colophon__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2) var(--s4);
    margin-top: var(--s5);
    padding-top: var(--s4);
    border-top: 1px solid var(--amber-ghost);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
  }
</style>
