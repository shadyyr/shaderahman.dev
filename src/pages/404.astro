---
import OsLayout from "../layouts/OsLayout.astro";
import PageHead from "../components/PageHead.astro";
import { ROUTES } from "../lib/site";
---

<OsLayout
  title="Not found"
  description="That path doesn't exist on this site."
  path="/404"
  noindex
>
  <PageHead eyebrow="Error 404" heading="No such path" />

  <div class="stack">
    <pre class="dump" aria-label="Terminal error output"><code>&gt; open <span class="dump__path" id="bad-path">the requested path</span>
  status : 404
  reason : no route matches
  action : pick one of the four below</code></pre>

    <nav aria-label="Available pages">
      <ul class="routes">
        {
          ROUTES.map((route) => (
            <li>
              <a href={route.path}>{route.title}</a>
              <span class="routes__path">{route.path}</span>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="muted">
      If you followed a link here from somewhere else on this site, that is a
      bug and I would like to know about it.
    </p>
  </div>
</OsLayout>

<script>
  // Echo back what was actually requested. Written as text, never as HTML,
  // so a crafted URL cannot inject anything into the page.
  const slot = document.getElementById("bad-path");
  if (slot) slot.textContent = window.location.pathname;
</script>

<style>
  .dump {
    border: 1px solid var(--amber-faint);
    border-left: 2px solid var(--red);
    background: var(--bg-inset);
    padding: var(--s4);
    overflow-x: auto;
    color: var(--amber-dim);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .dump code {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .dump__path {
    color: var(--red);
  }

  .routes {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .routes li {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
  }

  .routes__path {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    color: var(--amber-dim);
  }
</style>
