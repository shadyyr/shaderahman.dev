---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import CommandPalette from "../components/CommandPalette.astro";
import PlayerDock from "../components/PlayerDock.astro";
import { SITE, ROUTES } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  isHome?: boolean;
  crumbs?: { name: string; path: string }[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  isHome = false,
  crumbs,
  noindex = false,
} = Astro.props;

const route = ROUTES.find((r) => r.path === path);

/*
  The title bar path is split into a host and a route, and that split is the
  only reason this site fits a 320px viewport.

  It used to be one string, `shaderahman.dev/experience`. The bar is a flex row
  whose three children all keep `min-width: auto`, and that string contains no
  space, so its min-content width is the whole 26 characters and the bar's floor
  scaled with the length of the path. Measured floors were /experience 357px,
  /projects 341, /skills 326, against a 320px viewport, and every one of those
  overflows traced to this bar and nothing else on the page.

  So the host becomes its own element that global.css drops below 40rem, where
  the full URL is not telling anyone anything they cannot see in their own
  address bar. It is a real element rather than a second copy of the string
  under a media query, so nothing is duplicated in the DOM or announced twice.

  /404 has no route, so it shows its title ("Not found") and no host. That
  string has a space in it and never set the floor.
*/
const host = SITE.origin.replace(/^https?:\/\//, "");
const windowPath = route ? path : title;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      isHome={isHome}
      crumbs={crumbs}
      noindex={noindex}
    />
    {/*
      Swaps pages inside one document instead of loading a new one, which is
      the only reason the player can keep playing across a navigation: the
      iframe is never torn down. See PlayerDock.

      Links still work with JavaScript off. They are ordinary anchors and this
      only intercepts them when it is running, so the no-JS story is unchanged.

      The cost is that scripts no longer re-run per page. Anything that touches
      the DOM has to rebind on astro:page-load, and the three that do are the
      clock below, the command palette, and the player's panel.
    */}
    <ClientRouter />
  </head>
  <body>
    <a class="skiplink" href="#main">Skip to content</a>

    <div class="app">
      <header class="titlebar">
        <span class="titlebar__name">{SITE.system.label}</span>
        {/* One line on purpose. A newline between the host span and the path
            would emit a text node, and that space is a break opportunity the
            bar does not want back. */}
        <span class="titlebar__path">{route && <span class="titlebar__host">{host}</span>}{windowPath}</span>
        <span class="titlebar__glyphs" aria-hidden="true">[-][□][×]</span>
      </header>

      <div class="frame">
        <Sidebar path={path} />

        <main class="content" id="main">
          <slot />
        </main>
      </div>

      <footer class="statusbar">
        <div class="statusbar__hints">
          <span class="hint"><kbd>/</kbd> commands</span>
          {/*
            Derived from ROUTES rather than typed out. It read "H E P S" long
            after /design shipped with "d": the shortcut worked and the status
            bar quietly did not say so, because adding a route updated the one
            and not the other. Now a new route advertises itself.

            The capitals come from toUpperCase at build time, which puts real
            characters in the HTML, and not from text-transform, which the
            audit fails and which would be lossy. Same thing the command
            palette does with the same keys.
          */}
          <span class="hint">
            <kbd>{ROUTES.map((route) => route.key.toUpperCase()).join(" ")}</kbd> jump
          </span>
          <span class="hint"><kbd>G</kbd> GitHub</span>
          <span class="hint"><kbd>L</kbd> LinkedIn</span>
          <span class="hint"><kbd>R</kbd> résumé</span>
        </div>
        <time class="statusbar__clock" id="clock" aria-hidden="true"></time>
      </footer>
    </div>

    <div class="crt-overlay" aria-hidden="true"></div>

    <CommandPalette />
    <PlayerDock />

    <style>
      /* Keyboard hints are a promise. They stay hidden until the script that
         keeps that promise has actually run. */
      .hint {
        display: none;
      }

      :global(html[data-js]) .hint {
        display: inline;
      }

      /*
        A narrow window keeps the first two hints and drops the other three.

        This rule lives here, beside the one it has to outrank, rather than in
        global.css with the rest of the status bar. global.css carried it as

          .statusbar__hints > *:nth-child(n + 3) { display: none }

        which is (0,2,0), while Astro compiles the rule directly above into
        `html[data-js] .hint[data-astro-cid-4dqkvzst]`, which is (0,3,1). The
        more specific one won every time, so the pruning applied on exactly no
        page where JavaScript ran, which is every page. It read as deliberate
        in the source and had never executed.

        What that cost, measured on the built page with a fine pointer: the
        status bar was 68.2px tall at 375 and 101.8px at 320, two and three
        wrapped lines of hints, against 34.6px at 641 and above. With this rule
        it is 34.6px at every width.

        On touch none of this applies. The `pointer: coarse` block in global.css
        takes all five hints away, because each one names a key a phone does not
        have. The reader this rule is for is the other one: a narrow desktop
        window, which does have the keyboard the two survivors name.

        The selector compiles to (0,4,1), one class-level above the rule it has
        to beat. If you touch either of these two, check the pair still ranks
        the way it should, because the failure mode is silent.
      */
      @media (max-width: 40rem) {
        :global(html[data-js]) .hint:nth-child(n + 3) {
          display: none;
        }
      }
    </style>

    <script>
      /*
        The clock, and the one place the client router changes how this has to
        be written.

        This module executes once for the whole visit, not once per page, so
        two things follow. The interval must be started once, or every
        navigation would stack another one on top and the clock would tick
        several times a second. And the element it writes to is replaced on
        every navigation, so a reference captured here would be pointing at a
        detached node after the first click, and the clock would silently stop.

        So: one interval, and the element is looked up fresh on each tick.
      */
      /*
        Re-applied after every swap rather than set once, and that is a fix
        rather than a precaution. ClientRouter copies the incoming document's
        <html> attributes over the live element, and `data-js` is only ever
        added at runtime, so it is never present in the HTML being swapped in
        and every navigation dropped it. The five keyboard hints are gated on
        it and disappeared on the first click, while the clock, gated on
        nothing, went on ticking beside them.

        astro:after-swap, not astro:page-load: it fires while the new page is
        in the DOM but before it paints, so the hints never flash hidden.

        Anything else put on documentElement needs the same treatment. The
        dock's --dock-space is the other one, and it is handled in PlayerDock
        for the same reason.
      */
      const enableJs = () => document.documentElement.setAttribute("data-js", "");
      enableJs();
      document.addEventListener("astro:after-swap", enableJs);

      const tick = () => {
        const clock = document.getElementById("clock");
        if (!clock) return;
        const now = new Date();
        clock.textContent = now.toLocaleTimeString("en-US", { hour12: false });
        clock.setAttribute("datetime", now.toISOString());
      };

      tick();
      setInterval(tick, 1000);
      /* The swap lands a fresh, empty clock element; fill it without waiting up
         to a second for the next tick. */
      document.addEventListener("astro:page-load", tick);
    </script>
  </body>
</html>
