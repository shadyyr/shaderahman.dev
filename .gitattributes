# Line endings, normalised in the repository, native in the working tree.
* text=auto

# These .txt files are either served verbatim (robots.txt, llms.txt) or parsed
# a line at a time (src/data/tracks.txt), and core.autocrlf is on for some of
# the machines this repo gets cloned to. A file whose bytes depend on who
# checked it out is the wrong thing to be defending against downstream.
*.txt -text
