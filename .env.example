# Copy this to .env and fill in the value. .env is gitignored; this file is not.
#
# The client ID is not here because it is public and lives in scripts/spotify.mjs.
# Only the secret is sensitive.
#
#   developer.spotify.com/dashboard  ->  your app  ->  Settings  ->  View client secret
#
# The same value goes in Vercel's environment variables so deploys can refetch.
SPOTIFY_CLIENT_SECRET=
